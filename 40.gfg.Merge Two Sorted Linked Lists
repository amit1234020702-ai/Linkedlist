/*  Structure of Linked List Node
class Node
{
    int data;
    Node next;
    Node(int d) {
        data = d;
        next = null;
    }
} */

class Solution {
    Node sortedMerge(Node head1, Node head2) {
        if(head1==null){
            return head2;
        }else if(head2==null){
            return head1;    /////https://www.youtube.com/watch?v=JzeGCLDt4nE
        }
        Node newNode=new Node(0);
        Node currNode=newNode;
        while(head1!=null && head2!=null){
            if(head1.data<=head2.data){
                currNode.next=head1;
                head1=head1.next;
            }else{
                currNode.next=head2;
                head2=head2.next;
            }
            currNode=currNode.next;
            
        }
        if(head1==null){
            currNode.next=head2;
        }
        if(head2==null){
            currNode.next=head1;
        }
        return newNode.next;
    }
}
