/* Definition of a Linked List Node
class Node {
    int data;
    Node next;

    Node(int val) {
        data = val;
        next = null;
    }
}*/

class Solution {
    public Node sortedInsert(Node head1, int key) {
        Node newNode=new Node(key);
        Node prev=null;
        Node temp=head1;
        while(temp!=null){
            if(temp.data>=key){
                break;
            }
            prev=temp;
            temp=temp.next;
        }
        if(prev==null){
            newNode.next=head1;
            head1=newNode;
        }else{
            newNode.next=prev.next;
            prev.next=newNode;
        }
        return head1;
        
    }
}
