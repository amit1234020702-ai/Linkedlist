Input: head = [1,2,3,4,5]
Output: [1,3,5,2,4]
Input: head = [2,1,3,5,6,4,7]
Output: [2,3,6,7,1,5,4]



class Solution {
    public ListNode oddEvenList(ListNode head) {
        if(head==null){
            return null;
        }
        ListNode odd=head;
        ListNode even=head.next;
        ListNode evenHead=head.next;
        while(even !=null && even.next!=null){
      odd.next=even.next;
      odd=odd.next;
      even.next=odd.next;
      even=even.next;
        }
        odd.next=evenHead;
        return head;
    }
}
