24. **Remove Duplicates from Unsorted Linked List**

10 → 20 → 10 → 30 → 20 → 40 → null
10 → 20 → 30 → 40 → null

import java.util.HashSet;

class Solution {
    public Node removeDuplicates(Node head) {

        if (head == null) {
            return null;
        }

        HashSet<Integer> set = new HashSet<>();

        Node current = head;
        Node prev = null;

        while (current != null) {

            if (set.contains(current.data)) {
                // Duplicate node delete
                prev.next = current.next;
            } else {
                // First occurrence
                set.add(current.data);
                prev = current;
            }

            current = current.next;
        }

        return head;
    }
}
