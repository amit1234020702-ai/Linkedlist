16. **Delete Node by Value**
class Solution {
    public Node deleteByValue(Node head, int value) {

        // Empty list
        if (head == null) {
            return null;
        }

        // If head contains the value
        if (head.data == value) {
            return head.next;
        }

        Node current = head;

        // Find node just before the target node
        while (current.next != null &&
               current.next.data != value) {

            current = current.next;
        }

        // Delete target node
        if (current.next != null) {
            current.next = current.next.next;
        }

        return head;
    }
}
