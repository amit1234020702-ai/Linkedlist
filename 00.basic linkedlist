10. **Insert at Given Position** ⭐
class Solution {
    public Node insertBefore(Node head, int target, int val) {

        Node newNode = new Node(val);

        // Target is at head
        if (head.data == target) {
            newNode.next = head;
            return newNode;
        }

        Node current = head;

        // Find node just before target
        while (current.next != null &&
               current.next.data != target) {

            current = current.next;
        }

        // Target found
        if (current.next != null) {
            newNode.next = current.next;
            current.next = newNode;
        }

        return head;
    }
}

