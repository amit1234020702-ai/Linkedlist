14. **Delete Tail** ⭐
class Solution {
    public Node deleteTail(Node head) {

        // Empty list
        if (head == null) {
            return null;
        }

        // Only one node
        if (head.next == null) {
            return null;
        }

        Node current = head;

        // Reach second-last node
        while (current.next.next != null) {
            current = current.next;
        }

        // Remove last node
        current.next = null;

        return head;
    }
}


