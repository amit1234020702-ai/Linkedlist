9. **Insert at Tail** ⭐
class Solution {
    public Node insertAtTail(Node head, int val) {

        Node newNode = new Node(val);

        // If list is empty
        if (head == null) {
            return newNode;
        }

        Node current = head;

        // Go to the last node
        while (current.next != null) {
            current = current.next;
        }

        // Connect last node to new node
        current.next = newNode;

        return head;
    }
}
