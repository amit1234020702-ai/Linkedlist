22. **Check Palindrome Linked List** ⭐⭐
O(n) Time 
O(1) Space
##step
1.Middle find karo
2.Second half reverse karo
3.Dono halves compare karo

class Solution {
    public boolean isPalindrome(Node head) {

        // Empty list or single node
        if (head == null || head.next == null) {
            return true;
        }

        // Step 1: Find middle
        Node slow = head;
        Node fast = head;

        while (fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;
        }

        // Step 2: Reverse second half
        Node prev = null;
        Node current = slow;

        while (current != null) {
            Node next = current.next;

            current.next = prev;

            prev = current;
            current = next;
        }

        // Step 3: Compare both halves
        Node first = head;
        Node second = prev;

        while (second != null) {

            if (first.data != second.data) {
                return false;
            }

            first = first.next;
            second = second.next;
        }

        return true;
    }
}

