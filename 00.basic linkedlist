17. **Delete All Occurrences of a Value 
class Solution {
    public Node deleteAll(Node head, int value) {

        // Delete all matching nodes from the beginning
        while (head != null && head.data == value) {
            head = head.next;
        }

        Node current = head;

        // Delete matching nodes from remaining list
        while (current != null && current.next != null) {

            if (current.next.data == value) {
                current.next = current.next.next;
            } else {
                current = current.next;
            }
        }

        return head;
    }
}
