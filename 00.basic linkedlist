15. **Delete Node at Given Position** ⭐
class Solution {
    public Node deleteAtPosition(Node head, int pos) {

        // Empty list
        if (head == null) {
            return null;
        }

        // Delete head
        if (pos == 1) {
            return head.next;
        }

        Node current = head;

        // Reach node just before the position
        for (int i = 1; i < pos - 1; i++) {
            current = current.next;
        }

        // Delete the node
        current.next = current.next.next;

        return head;
    }
}

